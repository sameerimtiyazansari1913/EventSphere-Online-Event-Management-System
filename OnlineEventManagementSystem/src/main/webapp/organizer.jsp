<%@ page import="java.util.*,com.eventmanager.model.*" %><!doctype html><html><head><title>Organizer Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><header><b>EventSphere</b><span>Organizer Dashboard</span><a href="logout">Logout</a></header><main><h1>Manage Events</h1><div class="grid"><div class="card"><h2>Create Event</h2><form method="post" action="events"><input name="title" placeholder="Event title" required><textarea name="description" placeholder="Description"></textarea><input name="eventDate" type="date" required><input name="eventTime" type="time" required><input name="venue" placeholder="Venue" required><button>Create Event</button></form></div><div class="card"><h2>Your Events</h2><table><tr><th>Title</th><th>Date</th><th>Status</th></tr><% for(Event x:(List<Event>)request.getAttribute("events")){%><tr><td><%=x.title%></td><td><%=x.eventDate%></td><td><span class="badge"><%=x.status%></span></td></tr><%}%></table></div></div></main></body></html>
