<%@ page import="java.util.*,com.eventmanager.model.*" %><!doctype html><html><head><title>Admin Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><header><b>EventSphere</b><span>Admin Dashboard</span><a href="logout">Logout</a></header><main><h1>Admin Dashboard</h1><section class="grid"><div class="card"><h2>User Management</h2><table><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr><% for(User x:(List<User>)request.getAttribute("users")){%><tr><td><%=x.id%></td><td><%=x.name%></td><td><%=x.email%></td><td><%=x.role%></td><td><form method="post" action="admin"><input type="hidden" name="action" value="deleteUser"><input type="hidden" name="id" value="<%=x.id%>"><button class="danger">Delete</button></form></td></tr><%}%></table></div><div class="card"><h2>Pending Event Approvals</h2><table><tr><th>Title</th><th>Date</th><th>Venue</th><th>Action</th></tr><% for(Event x:(List<Event>)request.getAttribute("events")){%><tr><td><%=x.title%></td><td><%=x.eventDate%></td><td><%=x.venue%></td><td><form method="post" action="admin"><input type="hidden" name="id" value="<%=x.id%>"><button name="action" value="approve">Approve</button><button class="danger" name="action" value="reject">Reject</button></form></td></tr><%}%></table></div></section></main></body></html>
