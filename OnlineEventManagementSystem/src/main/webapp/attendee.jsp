<%@ page import="java.util.*,com.eventmanager.model.*,com.eventmanager.dao.TicketDAO" %><!doctype html><html><head><title>Attendee Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><header><b>EventSphere</b><span>Attendee Dashboard</span><a href="logout">Logout</a></header><main><h1>Available Events</h1><div class="cards"><% for(Event x:(List<Event>)request.getAttribute("events")){%><div class="card"><h2><%=x.title%></h2><p><%=x.description%></p><p><b>Date:</b> <%=x.eventDate%> &nbsp; <b>Time:</b> <%=x.eventTime%></p><p><b>Venue:</b> <%=x.venue%></p><% try{for(Ticket t:new TicketDAO().byEvent(x.id)){%><form method="post" action="purchase"><input type="hidden" name="eventId" value="<%=x.id%>"><input type="hidden" name="ticketId" value="<%=t.id%>"><input type="hidden" name="amount" value="<%=t.price%>"><button <%=t.quantity<=0?"disabled":""%>>Buy <%=t.ticketName%> — ₹<%=String.format("%.2f",t.price)%> (<%=t.quantity%> left)</button></form><%}}catch(Exception ignored){}%></div><%}%></div></main></body></html>
